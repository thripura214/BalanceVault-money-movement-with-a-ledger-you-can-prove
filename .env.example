# BalanceVault Configuration

# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (PostgreSQL / Neon)
DATABASE_URL="postgresql://balancevault_app:vaultpass123@localhost:5432/balancevault?schema=public"
DIRECT_URL="postgresql://balancevault_app:vaultpass123@localhost:5432/balancevault?schema=public"

# Redis Cache & Rate Limiting (Optional - falls back to memory if empty or unavailable)
REDIS_URL="redis://localhost:6379"

# JWT Authentication
JWT_SECRET="super-secret-jwt-key-balancevault-2026-production"
JWT_EXPIRES_IN="1d"

# Admin Bootstrap Security Token
BOOTSTRAP_SECRET="balancevault-secure-bootstrap-key-2026"

